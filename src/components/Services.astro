---
import { services } from '../data/content';

const icons: Record<string, string> = {
  document:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M8 13h8"></path><path d="M8 17h5"></path>',
  chat: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"></path>',
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>',
  custom:
    '<line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line>',
};
---

<section id="services" class="services">
  <div class="container">
    <div class="heading-block">
      <p class="eyebrow">WHAT I BUILD</p>
      <h2 class="section-heading">Three productized systems, plus custom builds.</h2>
    </div>
    <div class="grid">
      {
        services.map((service) => (
          <div class="card">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[service.icon]}
            />
            <div class="title">{service.title}</div>
            <p class="description" set:html={service.description} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    z-index: 1;
    padding-top: 96px;
  }

  .heading-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 28px;
  }

  .title {
    font-size: 20px;
    font-weight: 600;
  }

  .description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 767px) {
    .services {
      padding-top: 56px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .card {
      padding: 22px 20px;
    }
  }
</style>
