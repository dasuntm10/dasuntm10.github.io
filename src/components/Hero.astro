---
import { contact } from '../data/content';
---

<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow">AI ENGINEERING · PRODUCTION-GRADE · UTC+5:30</p>
    <h1>AI systems that survive contact with production.</h1>
    <p class="subhead">
      I design and build custom AI solutions catered to your use case, from document-extraction pipelines to
      grounded support assistants and booking agents, for small and mid-size businesses. Integration-heavy,
      measured with evals, delivered as fixed-scope packages.
    </p>
    <div class="ctas">
      <a href={contact.bookingHref} class="btn">Book a 15-minute call</a>
      <a href="#work" class="see-work">See the work ↓</a>
    </div>
    <p class="credential">4+ years of experience shipping production GenAI for US enterprise SaaS · ex-lead, 3-person NLP R&amp;D team</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 96px;
    padding-bottom: 72px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 66px);
    line-height: 1.05;
    max-width: 900px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .subhead {
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--muted);
    max-width: 680px;
    margin: 0;
  }

  .ctas {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .see-work {
    padding: 15px 10px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }

  .see-work:hover {
    color: var(--accent-hover);
  }

  .credential {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--faint);
    margin: 0;
  }

  @media (max-width: 767px) {
    .hero-inner {
      padding-top: 48px;
      padding-bottom: 40px;
      gap: 18px;
    }

    .ctas .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
