---
import { contact } from '../data/content';
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#about" class="wordmark">DASUN THEEKSHANA</a>
    <nav class="links" aria-label="Primary">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#services">Services</a>
      <a href="#process">Process</a>
      <a href={contact.bookingHref} class="btn btn-small nav-cta">Book a call</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 1;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: 36px;
    align-items: center;
  }

  .links a {
    font-size: 15px;
    color: var(--muted);
  }

  .links a:hover {
    color: var(--ink);
  }

  .nav-cta {
    color: #ffffff;
  }

  .nav-cta:hover {
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .nav-inner {
      padding-top: 18px;
      padding-bottom: 18px;
      flex-wrap: wrap;
      row-gap: 12px;
    }

    .wordmark {
      font-size: 12px;
    }

    .links {
      gap: 18px;
      flex-wrap: wrap;
      row-gap: 10px;
    }

    .links a:not(.nav-cta) {
      display: none;
    }

    .nav-cta {
      margin-left: auto;
    }
  }
</style>
