---
import { proofStats } from '../data/content';
---

<section class="proof">
  <div class="grid">
    {
      proofStats.map((item, i) => (
        <div class="cell" class:list={{ 'cell-first': i === 0 }}>
          <div class="stat">{item.stat}</div>
          <p class="caption">{item.caption}</p>
        </div>
      ))
    }
  </div>
  <p class="attribution container">
    Production results from GenAI systems I architected and shipped at Altrium / PlanYear (US) - methodology on request.
  </p>
</section>

<style>
  .proof {
    position: relative;
    z-index: 1;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .cell {
    background: var(--card-bg-soft);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cell-first {
    padding-left: var(--gutter-desktop);
  }

  .stat {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
  }

  .caption {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .attribution {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    padding-top: 12px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell-first {
      padding-left: 32px;
    }
  }

  @media (max-width: 599px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .cell {
      padding: 20px var(--gutter-mobile);
    }

    .cell-first {
      padding-left: var(--gutter-mobile);
    }
  }
</style>
